{
  "name": "@local/dsh-model-connect",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Sidebar panel for adding third-party OpenAI/Anthropic compatible endpoints and API keys, probing their model catalog, and saving them as dsh-llm-pi-ai routes.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
